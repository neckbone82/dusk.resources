#!/bin/bash

# Configuration (from dev's original script)
EVENCOLOR="^C1^"
ODDCOLOR="^C1^"
TEXTCOLOR="^d^"
HEIGHT=${BAR_HEIGHT:-18} # Default height if not set
TMPFILE="/tmp/.${USER}.statusbar.volume.${DISPLAY}.dat~"

# 1. Check if Muted (PipeWire / Pamixer version)
if [ "$(pamixer --get-mute)" == "true" ]; then
    echo "🔇"
    exit
fi

# 2. Get Volume Percentage (PipeWire / Pamixer version)
# Returns a clean number like "65"
VOLUME=$(pamixer --get-volume)

if [ -z "$VOLUME" ]; then
    echo " %"
    exit
fi

# 3. Call the Dev's Fancy Visualizer
# This keeps the "intended" look (graphical bars)
${HOME}/.local/bin/slstatusbar/status2d_volume -p "$VOLUME" -h "$HEIGHT" --textcolor "$TEXTCOLOR" --oddcolor "$ODDCOLOR" --evencolor "$EVENCOLOR"
